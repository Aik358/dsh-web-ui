{
  "$schema": "https://schemas.linxin666.org/dsh-skin/v2.json",
  "skinManifestVersion": 2,
  "id": "starry-nocturne",
  "name": "星夜夜曲",
  "nameEn": "Starry Nocturne",
  "version": "0.1.0",
  "author": "theater",
  "tagline": "哥特蕾丝 · 星空夜曲 · 蕾丝白与丝绒午夜",
  "description": "哥特萝莉与星空主题的双面皮肤：光模式是蕾丝白画布上的星夜裙立绘，暗模式以整幅星空少女场景铺底、银尘星屑漂浮。皇室蓝紫贯穿令牌层，红丝带微光作为秘密记号，支持皮肤中心原生的背景遮挡与磨砂调节。",
  "tags": [
    "gothic",
    "starry",
    "lace",
    "midnight",
    "amethyst"
  ],
  "accent": "#5B5FC7",
  "order": 31,
  "license": "CC-BY-NC-SA-4.0",
  "attribution": "角色插画由作者本人提供，内置皮肤中心运行时与背景遮挡/磨砂调节配合使用",
  "preview": {
    "light": "preview/light.jpg",
    "dark": "preview/dark.jpg"
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "x-org.linxin666.skin-center/v1alpha1",
        "kind": "SkinHooks",
        "optional": true
      }
    ]
  },
  "contributes": {
    "stylesheet": "skin.css",
    "backgroundMedia": {
      "light": {
        "type": "image",
        "src": "assets/background-light.webp",
        "scrim": "linear-gradient(rgba(250, 250, 253, 0.12) 0%, rgba(248, 248, 252, 0.2) 52%, rgba(241, 241, 249, 0.28) 100%)"
      },
      "dark": {
        "type": "image",
        "src": "assets/background-dark.webp",
        "scrim": "linear-gradient(rgba(12, 16, 38, 0.22) 0%, rgba(12, 16, 38, 0.34) 50%, rgba(11, 14, 34, 0.42) 100%)"
      }
    }
  },
  "facets": {
    "client": {
      "entry": "hooks.mjs",
      "apiVersion": "x-org.linxin666.skin-center/v1alpha1"
    }
  }
}
